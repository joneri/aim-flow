{
  "name": "fake-atg-testbed",
  "version": "0.1.0",
  "private": true,
  "description": "Fictional deterministic horse-betting product testbed for agentic delivery evaluation.",
  "type": "module",
  "scripts": {
    "dev": "npm run reset && vite --host 127.0.0.1",
    "build": "npm run reset && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "reset": "node scripts/reset.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test:reset": "node --test tests/reset/*.test.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/e2e/journey.spec.ts tests/e2e/control-room.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test": "npm run test:reset && npm run test:unit && npm run test:integration",
    "e2e:install": "playwright install chromium",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run test:a11y"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.3.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
